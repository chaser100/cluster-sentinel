    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Sortable breakdown of registered events. Click column headers to sort.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "count_1h"
              },
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "id": 10,
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "count_1h"
          }
        ],
        "footer": {
          "enablePagination": true
        }
      },
      "title": "Events by namespace / type / reason / kind / source",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "pod": true
            },
            "indexByName": {
              "event_namespace": 0,
              "type": 1,
              "reason": 2,
              "involved_kind": 3,
              "source": 4,
              "Value": 5
            },
            "renameByName": {
              "event_namespace": "event_namespace",
              "involved_kind": "kind",
              "Value": "count_1h"
            }
          }
        }
      ],
      "type": "table",
      "targets": [
        {
          "expr": "sum by (event_namespace, type, reason, involved_kind, source) (increase(clustersentinel_events_registered_total{event_namespace=~\"$event_namespace\",type=~\"$event_type\",reason=~\"$reason\",involved_kind=~\"$involved_kind\",source=~\"$source\"}[$__range]))",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
