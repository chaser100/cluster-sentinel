      "id": 102,
      "panels": [],
      "title": "Event detail (kubectl-like)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "kubectl-style event detail from ClusterSentinel registry (message truncated to 256 chars in Prometheus labels; full text via /api/v1/events or MCP).",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "LAST SEEN"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "TYPE"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "REASON"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 160
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "OBJECT"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 280
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "MESSAGE"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 520
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "COUNT"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 20,
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "LAST SEEN"
          }
        ],
        "footer": {
          "enablePagination": true
        }
      },
      "title": "Recent events (LAST SEEN / TYPE / REASON / OBJECT / MESSAGE)",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "pod": true,
              "namespace": true,
              "endpoint": true,
              "service": true,
              "container": true
            },
            "indexByName": {
              "Value": 0,
              "type": 1,
              "reason": 2,
              "involved_object": 3,
              "message": 4,
              "count": 5,
              "event_namespace": 6,
              "source": 7
            },
            "renameByName": {
              "Value": "LAST SEEN",
              "type": "TYPE",
              "reason": "REASON",
              "involved_object": "OBJECT",
              "message": "MESSAGE",
              "count": "COUNT",
              "event_namespace": "NAMESPACE",
              "source": "SOURCE"
            }
          }
        }
      ],
      "type": "table",
      "targets": [
        {
          "expr": "clustersentinel_event_last_seen_timestamp{event_namespace=~\"$event_namespace\",type=~\"$event_type\",reason=~\"$reason\",involved_object=~\"($involved_kind)/.*\",source=~\"$source\"} * 1000",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
